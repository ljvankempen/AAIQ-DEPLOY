{
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "public_url": "https://taperc.aaiq.nl",
    "device_ws_path": "/device/connect",
    "client_ws_path": "/client/connect",
    "default_device_id": "AAIQ-RBP-001",
    "heartbeat_interval_sec": 15,
    "heartbeat_timeout_sec": 45,
    "log_level": "INFO"
  },
  "security": {
    "master_key": "taperc_master_secret_key_change_in_production",
    "secrets_file": "/opt/aaiq/taperc/public-taperc/config/secrets.json",
    "require_client_auth": true,
    "require_device_auth": true
  },
  "devices": [
    {
      "device_id": "AAIQ-RBP-001",
      "name": "Revox PR99 Studio 1",
      "secret_id": "sec_rbp_pr99_001",
      "relay_count": 8,
      "enabled": true
    },
    {
      "device_id": "AAIQ-RBP-002",
      "name": "Revox B77 Deck 2",
      "secret_id": "sec_rbp_b77_002",
      "relay_count": 8,
      "enabled": true
    }
  ],
  "clients": [
    {
      "client_id": "aaiq-pwa-user",
      "token": "cli_token_user_secret_key_abcde",
      "allowed_devices": ["*"],
      "role": "operator",
      "enabled": true
    }
  ]
}
