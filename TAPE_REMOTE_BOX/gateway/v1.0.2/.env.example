# ==============================================================================
# TAPERC Public Gateway — Environment Configuration (.env)
# ==============================================================================
# VPS Deployment Target: /opt/aaiq/taperc/public-taperc/
# Public URL: https://taperc.aaiq.nl
# Device WebSocket: wss://taperc.aaiq.nl/device/connect
# ==============================================================================

# Server binding (Runs behind reverse proxy such as Caddy / Nginx)
TAPERC_HOST=127.0.0.1
TAPERC_PORT=8080

# Public URLs
TAPERC_PUBLIC_URL=https://taperc.aaiq.nl
TAPERC_DEVICE_WS_PATH=/device/connect
TAPERC_CLIENT_WS_PATH=/client/connect

# Default Device (Phase 1 PWA backward compatibility)
TAPERC_DEFAULT_DEVICE_ID=AAIQ-RBP-001

# Gateway Security, Master Key & Secrets
TAPERC_MASTER_KEY=taperc_master_secret_key_change_in_production
TAPERC_CONFIG_FILE=/opt/aaiq/taperc/public-taperc/config/config.json
TAPERC_SECRETS_FILE=/opt/aaiq/taperc/public-taperc/config/secrets.json

# Heartbeat & Timeouts (seconds)
TAPERC_HEARTBEAT_INTERVAL=15
TAPERC_HEARTBEAT_TIMEOUT=45

# Logging
TAPERC_LOG_LEVEL=INFO
